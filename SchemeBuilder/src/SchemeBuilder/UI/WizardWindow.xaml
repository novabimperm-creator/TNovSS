<Window x:Class="SchemeBuilder.UI.WizardWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="СТРУКТУРНАЯ СХЕМА"
        Width="1080"
        Height="720"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="6,6,6,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="СТРУКТУРНАЯ СХЕМА"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="Cancel_Click"
                            IsCancel="True"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource PanelFrameStyle}" Padding="8">
                    <ListBox x:Name="StepsList"
                             Style="{StaticResource JournalListBoxStyle}"
                             IsHitTestVisible="False"
                             Focusable="False"/>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource PanelFrameStyle}"
                        Padding="14,12">
                    <Grid>
                        <!-- Шаг 1 -->
                        <Grid x:Name="Step0" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Шаг 1. Что считать оборудованием раздела"
                                       Style="{StaticResource PanelHeaderStyle}"/>
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource DialogHintStyle}"
                                       Margin="0,0,0,10"
                                       Text="В списке только те категории, где в модели что-то есть, с числом экземпляров. Отверстия, гильзы и закладные обычно лежат в обобщённых моделях — их включать не нужно."/>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="CategoriesList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Caption}"
                                                      IsChecked="{Binding IsChecked}"
                                                      Style="{StaticResource DarkCheckBoxStyle}"
                                                      Margin="0,0,0,8"
                                                      Checked="OnCategoryChecked"
                                                      Unchecked="OnCategoryChecked"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="FoundSummary"
                                       Grid.Row="3"
                                       Style="{StaticResource DialogMessageStyle}"
                                       Margin="0,10,0,0"/>
                        </Grid>

                        <!-- Шаг 2 -->
                        <Grid x:Name="Step1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Шаг 2. Как оборудование называется в таблице"
                                       Style="{StaticResource PanelHeaderStyle}"/>
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource DialogHintStyle}"
                                       Margin="0,0,0,8"
                                       Text="Код — префикс марки, наименование — ADSK_Наименование. И то, и другое правится прямо здесь: в марках попадаются опечатки, а паспортный текст в колонку не помещается. Правки хранятся в модели."/>
                            <CheckBox x:Name="OnlyWithCode"
                                      Grid.Row="2"
                                      Content="Показывать только строки с кодом"
                                      Style="{StaticResource DarkCheckBoxStyle}"
                                      IsChecked="True"
                                      Margin="0,0,0,8"
                                      Checked="OnOnlyWithCodeChanged"
                                      Unchecked="OnOnlyWithCodeChanged"/>
                            <DataGrid x:Name="CodesGrid"
                                      Grid.Row="3"
                                      Style="{StaticResource DarkDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                                      CellStyle="{StaticResource DarkDataGridCellStyle}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      HeadersVisibility="Column"
                                      SelectionUnit="Cell">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header=""
                                                            Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="36"/>
                                    <DataGridTextColumn Header="Код"
                                                        Binding="{Binding Code, UpdateSourceTrigger=LostFocus}"
                                                        Width="70"/>
                                    <DataGridTextColumn Header="Наименование"
                                                        Binding="{Binding Description, UpdateSourceTrigger=LostFocus}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="Тип"
                                                        Binding="{Binding TypeCaption}"
                                                        Width="220"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                                    <DataGridTextColumn Header="Шт."
                                                        Binding="{Binding Count}"
                                                        Width="50"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                                    <DataGridTextColumn Header="Замечание"
                                                        Binding="{Binding Problem}"
                                                        Width="220"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="RowsSummary"
                                       Grid.Row="4"
                                       Style="{StaticResource DialogHintStyle}"
                                       Margin="0,8,0,0"/>
                        </Grid>

                        <!-- Шаг 3 -->
                        <Grid x:Name="Step2" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Шаг 3. Чем считать зону"
                                       Style="{StaticResource PanelHeaderStyle}"/>
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource DialogHintStyle}"
                                       Margin="0,0,0,10"
                                       Text="Зона — колонка будущей матрицы: квартира, коридор, лифтовый холл, ЩТС. Помещения ищутся и в этой модели, и в связях. Для легенды зоны не нужны — этот шаг готовит данные для схемы."/>
                            <Grid Grid.Row="2" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Зона по:" Style="{StaticResource InfoCardLabelStyle}"/>
                                <TextBlock x:Name="ZoneParameterLabel"
                                           Grid.Column="2"
                                           Text="Имя параметра:"
                                           Style="{StaticResource InfoCardLabelStyle}"/>
                                <ComboBox x:Name="ZoningBox"
                                          Grid.Row="1"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          Margin="0"
                                          SelectionChanged="OnZoningChanged"/>
                                <TextBox x:Name="ZoneParameterBox"
                                         Grid.Row="1"
                                         Grid.Column="2"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         Height="38"/>
                                <Button Grid.Row="1"
                                        Grid.Column="4"
                                        Content="Проверить"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="RecalculateZones_Click"
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        MinWidth="120"/>
                            </Grid>
                            <DataGrid x:Name="ZonesGrid"
                                      Grid.Row="3"
                                      Style="{StaticResource DarkDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                                      CellStyle="{StaticResource DarkDataGridCellStyle}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Этаж" Binding="{Binding Floor}" Width="200"
                                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                                    <DataGridTextColumn Header="Отметка" Binding="{Binding Elevation}" Width="90"
                                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                                    <DataGridTextColumn Header="Зона" Binding="{Binding Zone}" Width="*"
                                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                                    <DataGridTextColumn Header="Устройств" Binding="{Binding Count}" Width="90"
                                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="ZonesSummary"
                                       Grid.Row="4"
                                       Style="{StaticResource DialogMessageStyle}"
                                       Margin="0,8,0,0"/>
                            <TextBlock x:Name="ZonesNotes"
                                       Grid.Row="5"
                                       Style="{StaticResource DialogHintStyle}"
                                       Margin="0,4,0,0"/>
                        </Grid>

                        <!-- Шаг 4 -->
                        <Grid x:Name="Step3" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Шаг 4. Легенда УГО: где и как строить таблицу"
                                       Style="{StaticResource PanelHeaderStyle}"/>
                            <CheckBox x:Name="BuildLegendBox"
                                      Grid.Row="1"
                                      Content="Строить легенду УГО"
                                      Style="{StaticResource DarkCheckBoxStyle}"
                                      Margin="0,0,0,10"
                                      Checked="OnBuildLegendChanged"
                                      Unchecked="OnBuildLegendChanged"/>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="LegendPanel">
                                    <CheckBox x:Name="LineLegendBox"
                                              Content="Добавить блок типов линий (АЛС, ЛСО, ЛРО, питание)"
                                              Style="{StaticResource DarkCheckBoxStyle}"
                                              Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Легенда:" Style="{StaticResource InfoCardLabelStyle}"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="Тип текста (им набираются и легенда, и схема):"
                                                   Style="{StaticResource InfoCardLabelStyle}"/>
                                        <ComboBox x:Name="LegendPicker"
                                                  Grid.Row="1"
                                                  Style="{StaticResource DarkComboBoxStyle}"
                                                  Margin="0"
                                                  SelectionChanged="OnLegendPicked"/>
                                        <ComboBox x:Name="TextTypeBox"
                                                  Grid.Row="1"
                                                  Grid.Column="2"
                                                  Style="{StaticResource DarkComboBoxStyle}"
                                                  Margin="0"/>
                                    </Grid>
                                    <TextBlock x:Name="TemplateStatus"
                                               Style="{StaticResource DialogMessageStyle}"
                                               Margin="0,0,0,14"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource DialogHintStyle}"
                                               Margin="0,0,0,8"
                                               Text="Размеры на листе, мм. Высота строки — минимальная: под длинное наименование строка вырастет сама."/>
                                    <WrapPanel>
                                        <StackPanel Width="140" Margin="0,0,12,8">
                                            <TextBlock Text="Высота строки" Style="{StaticResource InfoCardLabelStyle}"/>
                                            <TextBox x:Name="RowHeightBox" Style="{StaticResource DarkTextBoxStyle}" Height="36" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Width="140" Margin="0,0,12,8">
                                            <TextBlock Text="Колонка УГО" Style="{StaticResource InfoCardLabelStyle}"/>
                                            <TextBox x:Name="SymbolWidthBox" Style="{StaticResource DarkTextBoxStyle}" Height="36" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Width="140" Margin="0,0,12,8">
                                            <TextBlock Text="Колонка кода" Style="{StaticResource InfoCardLabelStyle}"/>
                                            <TextBox x:Name="CodeWidthBox" Style="{StaticResource DarkTextBoxStyle}" Height="36" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Width="160" Margin="0,0,12,8">
                                            <TextBlock Text="Колонка наименования" Style="{StaticResource InfoCardLabelStyle}"/>
                                            <TextBox x:Name="DescriptionWidthBox" Style="{StaticResource DarkTextBoxStyle}" Height="36" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Width="140" Margin="0,0,12,8">
                                            <TextBlock Text="Строк в колонке" Style="{StaticResource InfoCardLabelStyle}"/>
                                            <TextBox x:Name="RowsPerColumnBox" Style="{StaticResource DarkTextBoxStyle}" Height="36" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Шаг 5 -->
                        <Grid x:Name="Step4" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Шаг 5. Матрица схемы"
                                       Style="{StaticResource PanelHeaderStyle}"/>
                            <TextBlock Grid.Row="1"
                                       Style="{StaticResource DialogHintStyle}"
                                       Margin="0,0,0,8"
                                       Text="Строки — этажи сверху вниз, в строке ячейки помещений: имя сверху, под ним блоки «код и количество». У подвала и первого этажа помещения свои, поэтому сетка не сквозная — строки просто растянуты до общей ширины."/>
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                                    <StackPanel>
                                        <CheckBox x:Name="BuildMatrixBox"
                                                  Content="Чертить матрицу схемы"
                                                  Style="{StaticResource DarkCheckBoxStyle}"
                                                  Margin="0,0,0,8"
                                                  Checked="OnBuildMatrixChanged"
                                                  Unchecked="OnBuildMatrixChanged"/>
                                        <StackPanel x:Name="MatrixPanel">
                                        <WrapPanel Margin="0,0,0,8">
                                            <CheckBox x:Name="CollapseTypicalBox"
                                                      Content="Сводить одинаковые этажи в строку «2–16 этаж (тип.)»"
                                                      Style="{StaticResource DarkCheckBoxStyle}"
                                                      Margin="0,0,20,8"
                                                      Checked="RefreshMatrix_Click"
                                                      Unchecked="RefreshMatrix_Click"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                                                <TextBlock Text="Порядок ячеек:"
                                                           Style="{StaticResource InfoCardLabelStyle}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <ComboBox x:Name="CellOrderBox"
                                                          Style="{StaticResource DarkComboBoxStyle}"
                                                          Width="190"
                                                          Margin="0"
                                                          SelectionChanged="RefreshMatrix_Click"/>
                                            </StackPanel>
                                            <CheckBox x:Name="OrderReversedBox"
                                                      Content="в обратную сторону"
                                                      Style="{StaticResource DarkCheckBoxStyle}"
                                                      Margin="0,0,0,8"
                                                      Checked="RefreshMatrix_Click"
                                                      Unchecked="RefreshMatrix_Click"/>
                                        </WrapPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Черновой вид:" Style="{StaticResource InfoCardLabelStyle}"/>
                                            <TextBlock Grid.Column="2" Text="Масштаб 1:" Style="{StaticResource InfoCardLabelStyle}"/>
                                            <TextBlock Grid.Column="4" Text="Блок, мм" Style="{StaticResource InfoCardLabelStyle}"/>
                                            <TextBlock Grid.Column="6" Text="Высота блока" Style="{StaticResource InfoCardLabelStyle}"/>
                                            <TextBlock Grid.Column="8" Text="Блоков в строке" Style="{StaticResource InfoCardLabelStyle}"/>
                                            <TextBlock Grid.Column="10" Text="Колонка этажа" Style="{StaticResource InfoCardLabelStyle}"/>
                                            <TextBox x:Name="MatrixViewNameBox" Grid.Row="1" Style="{StaticResource DarkTextBoxStyle}" Height="36"/>
                                            <TextBox x:Name="MatrixScaleBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource DarkTextBoxStyle}" Height="36" LostFocus="RefreshMatrixSummary_LostFocus"/>
                                            <TextBox x:Name="MatrixBlockBox" Grid.Row="1" Grid.Column="4" Style="{StaticResource DarkTextBoxStyle}" Height="36" LostFocus="RefreshMatrix_LostFocus"/>
                                            <TextBox x:Name="MatrixBlockHeightBox" Grid.Row="1" Grid.Column="6" Style="{StaticResource DarkTextBoxStyle}" Height="36" LostFocus="RefreshMatrixSummary_LostFocus"/>
                                            <TextBox x:Name="MatrixPerLineBox" Grid.Row="1" Grid.Column="8" Style="{StaticResource DarkTextBoxStyle}" Height="36" LostFocus="RefreshMatrix_LostFocus"/>
                                            <TextBox x:Name="MatrixFloorColumnBox" Grid.Row="1" Grid.Column="10" Style="{StaticResource DarkTextBoxStyle}" Height="36" LostFocus="RefreshMatrixSummary_LostFocus"/>
                                        </Grid>
                                        <WrapPanel Margin="0,8,0,8">
                                            <CheckBox x:Name="DrawUgoBox"
                                                      Style="{StaticResource DarkCheckBoxStyle}"
                                                      Margin="0,0,20,8"/>
                                            <CheckBox x:Name="DrawTrunksBox"
                                                      Content="Чертить магистрали (АЛС, ЛСО, ЛРО, питание)"
                                                      Style="{StaticResource DarkCheckBoxStyle}"
                                                      Margin="0,0,20,8"/>
                                            <CheckBox x:Name="ShowUnzonedBox"
                                                      Content="Показывать «зона не определена»"
                                                      Style="{StaticResource DarkCheckBoxStyle}"
                                                      Margin="0,0,20,8"
                                                      Checked="RefreshMatrix_Click"
                                                      Unchecked="RefreshMatrix_Click"/>
                                        </WrapPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Стояки:"
                                                       Style="{StaticResource InfoCardLabelStyle}"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox x:Name="TrunkPositionBox"
                                                      Grid.Column="2"
                                                      Style="{StaticResource DarkComboBoxStyle}"
                                                      Margin="0"
                                                      SelectionChanged="RefreshMatrix_Click"/>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Щит — своя ячейка, если в имени типа есть:"
                                                           Style="{StaticResource InfoCardLabelStyle}"/>
                                                <TextBox x:Name="PanelPatternBox"
                                                         Style="{StaticResource DarkTextBoxStyle}"
                                                         Height="36"
                                                         Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource DialogHintStyle}"
                                                   Text="Вид создаётся плагином. Если вид с таким именем уже есть — схема строится в нём."/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                                <DataGrid x:Name="MatrixGrid"
                                          Grid.Row="1"
                                          Style="{StaticResource DarkDataGridStyle}"
                                          ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                                          CellStyle="{StaticResource DarkDataGridCellStyle}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          LoadingRow="MatrixGrid_LoadingRow"/>
                            </Grid>
                            <TextBlock x:Name="MatrixSummary"
                                       Grid.Row="3"
                                       Style="{StaticResource DialogMessageStyle}"
                                       Margin="0,8,0,0"/>
                        </Grid>

                        <!-- Шаг 6 -->
                        <Grid x:Name="Step5" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Шаг 6. Что будет построено"
                                       Style="{StaticResource PanelHeaderStyle}"/>
                            <CheckBox x:Name="PlaceOnSheetBox"
                                      Grid.Row="1"
                                      Content="Положить схему на лист с основной надписью"
                                      Style="{StaticResource DarkCheckBoxStyle}"
                                      Margin="0,0,0,12"
                                      Checked="OnPlaceOnSheetChanged"
                                      Unchecked="OnPlaceOnSheetChanged"/>
                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Номер листа:" Style="{StaticResource InfoCardLabelStyle}"/>
                                <TextBlock Grid.Column="2" Text="Имя листа:" Style="{StaticResource InfoCardLabelStyle}"/>
                                <TextBlock Grid.Column="4" Text="Основная надпись:" Style="{StaticResource InfoCardLabelStyle}"/>
                                <TextBox x:Name="SheetNumberBox" Grid.Row="1" Style="{StaticResource DarkTextBoxStyle}" Height="36"/>
                                <TextBox x:Name="SheetNameBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource DarkTextBoxStyle}" Height="36"/>
                                <ComboBox x:Name="TitleBlockBox" Grid.Row="1" Grid.Column="4" Style="{StaticResource DarkComboBoxStyle}" Margin="0"/>
                            </Grid>
                            <TextBlock Grid.Row="3"
                                       Style="{StaticResource DialogHintStyle}"
                                       Margin="0,0,0,10"
                                       Text="Лист заводится один раз и дальше переиспользуется: вид можно положить только на один лист. Штамп на готовом листе меняется, если выбрать здесь другой."/>
                            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="FinalSummary"
                                           Style="{StaticResource DialogMessageStyle}"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton"
                        Content="Назад"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="Back_Click"
                        Margin="0"/>
                <Button Grid.Column="2"
                        Content="Отмена"
                        Style="{StaticResource CloseButtonStyle}"
                        Click="Cancel_Click"
                        IsCancel="True"
                        Margin="0"/>
                <Button x:Name="NextButton"
                        Grid.Column="4"
                        Content="Далее"
                        Style="{StaticResource RunButtonStyle}"
                        Click="Next_Click"
                        IsDefault="True"
                        Margin="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
